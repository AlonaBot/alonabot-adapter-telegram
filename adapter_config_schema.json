{
  "token": {
    "type": "string",
    "secret": true,
    "required": true
  },
  "api_base_url": {
    "type": "string",
    "default": "https://api.telegram.org"
  },
  "proxy_mode": {
    "type": "string",
    "options": [
      "none",
      "core",
      "custom"
    ],
    "default": "none"
  },
  "proxy": {
    "type": "string",
    "secret": true,
    "condition": {
      "proxy_mode": "custom"
    }
  },
  "file_base_url": {
    "type": "string",
    "default": ""
  },
  "auto_sync_commands": {
    "type": "bool",
    "default": true
  },
  "clear_commands_on_disable": {
    "type": "bool",
    "default": true
  }
}
